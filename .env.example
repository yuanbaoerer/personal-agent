# Feishu self-built app. See docs/04-build-plan.md §2.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
# Optional. When set, event signatures are required and encrypted events are decrypted.
FEISHU_ENCRYPT_KEY=

# webhook: receive events via the HTTP callback; long_connection: outbound WebSocket, no public URL.
FEISHU_EVENT_MODE=webhook

# Local model access. The Node process uses pi-durable in-process, so model
# tasks run locally once this key is set; without it they fail explicitly.
OPENCODE_API_KEY=
MODEL_PROVIDER=opencode-go
OPENCODE_MODEL=deepseek-v4.1-flash

# Explicit operator binding. Never inferred from a nickname or model output.
OWNER_FEISHU_OPEN_ID=

# Local service settings.
PORT=8787
# pa_* tables (application state).
DATABASE_PATH=./data/agent.sqlite
# pi_* tables (Pi transcripts). Kept in a separate SQLite file: pi owns its own
# storage handle and node:sqlite has a single writer. Back up both files.
PI_DATABASE_PATH=./data/pi.sqlite
# Required for GitHub OAuth start/status/disconnect and local Client API bootstrap.
# The CLI falls back to this only for local use; remote devices should use a
# short-lived/scoped `pa tokens create` token instead.
ADMIN_TOKEN=

# CLI/TUI (read by `pa`, not required by the server).
PA_API_URL=http://127.0.0.1:8787
PA_API_TOKEN=

# Optional read-only GitHub connector. Both values are required for the tool
# to be registered; allowed repos are comma-separated owner/name entries.
GITHUB_TOKEN=
GITHUB_ALLOWED_REPOS=
# Optional GitHub OAuth App for the local owner. Set client id/secret and a
# 32-byte encryption key (base64 or 64 hex chars); callback must match exactly.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_ENCRYPTION_KEY=
# Optional; defaults to http://127.0.0.1:8787/oauth/github/callback
GITHUB_OAUTH_REDIRECT_URI=
# Defaults to read:user,public_repo. Add repo explicitly for private repos.
GITHUB_OAUTH_SCOPES=

# Outbox delivery policy.
OUTBOX_LEASE_MS=15000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_MS=1000

# Local persistent model-request budget. Per-task limit is always enforced;
# set a daily limit explicitly or leave it unset. Counters live in pa_meta.
BUDGET_MAX_MODEL_CALLS_PER_TASK=10
# BUDGET_MAX_MODEL_CALLS_PER_DAY=100
BUDGET_MAX_TOOL_CALLS_PER_TASK=20

# Optional Magpie usage/quotas adapter. Set URL only when Magpie runs locally.
MAGPIE_URL=
MAGPIE_GATEWAY_KEY=magpie-personal-agent
MAGPIE_MIN_REMAINING_PERCENT=5
